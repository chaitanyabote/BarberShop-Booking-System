@model IEnumerable<BarberShopMVC_2.Models.Order>

@{
    ViewData["Title"] = "All Orders";
}

<h2>All Orders</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>User</th>
            <th>Date</th>
            <th>Total</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderId</td>
                <td>@(order.User?.Email ?? "Guest")</td>
                <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                <td>₹@order.TotalAmount</td>
                <td>
                    @if (order.Status == BarberShopMVC_2.Models.OrderStatus.Pending)
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                    else if (order.Status == BarberShopMVC_2.Models.OrderStatus.Completed)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else if (order.Status == BarberShopMVC_2.Models.OrderStatus.Cancelled)
                    {
                        <span class="badge bg-danger">Cancelled</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.OrderId">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
