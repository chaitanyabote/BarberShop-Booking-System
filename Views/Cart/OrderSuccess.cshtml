@model BarberShopMVC_2.Models.Order

@{
    ViewData["Title"] = "Order Successful";
    // Calculate a realistic estimated delivery date (3 days from now)
    var deliveryDate = Model.OrderDate.AddDays(3);
}

<div class="container mt-5 mb-5" style="max-width: 650px; font-family: 'Plus Jakarta Sans', sans-serif;">
    <div class="card shadow border-0" style="border-radius: 20px; overflow: hidden;">

        <div class="bg-success text-white text-center py-4" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
            <div class="mb-2">
                <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold mb-1">Order Confirmed!</h2>
            <p class="mb-0 opacity-75">Thank you for shopping with us.</p>
        </div>

        <div class="card-body p-4 p-md-5">

            <div class="row text-center mb-4 pb-3" style="border-bottom: 2px dashed #e2e8f0;">
                <div class="col-6" style="border-right: 2px dashed #e2e8f0;">
                    <small class="text-muted fw-bold text-uppercase tracking-wider">Order Number</small>
                    <h5 class="fw-bold text-dark mt-1 mb-0">#@Model.OrderId.ToString("D6")</h5>
                </div>
                <div class="col-6">
                    <small class="text-muted fw-bold text-uppercase tracking-wider">Est. Delivery</small>
                    <h5 class="fw-bold text-primary mt-1 mb-0">@deliveryDate.ToString("dd MMM, yyyy")</h5>
                </div>
            </div>

            <h5 class="fw-bold text-dark mb-3">Order Details</h5>
            <ul class="list-group list-group-flush mb-4">
                @foreach (var item in Model.OrderItems)
                {
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center border-light">
                        <div>
                            <h6 class="my-0 fw-semibold text-dark">@item.ProductName</h6>
                            <small class="text-muted">Qty: @item.Quantity</small>
                        </div>
                        <span class="text-dark fw-medium">₹@(item.Price* item.Quantity)</span>
                    </li>
                }
            </ul>

            <div class="d-flex justify-content-between align-items-center p-3 mb-4" style="background-color: #f8fafc; border-radius: 12px;">
                <span class="fw-bold text-muted text-uppercase">Total Paid</span>
                <h3 class="fw-bold text-success mb-0">₹@Model.TotalAmount</h3>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-dark px-4 py-3 rounded-pill fw-semibold shadow-sm" style="transition: 0.3s;">
                    <i class="bi bi-box-seam me-2"></i> Track Order
                </a>
                <a asp-controller="Store" asp-action="Index" class="btn btn-outline-secondary px-4 py-3 rounded-pill fw-semibold" style="border-width: 2px; transition: 0.3s;">
                    <i class="bi bi-shop me-2"></i> Continue Shopping
                </a>
            </div>

        </div>
    </div>
</div>