@model BarberShopMVC_2.Models.Booking

@{
    ViewData["Title"] = $"Book at {ViewBag.ShopName}";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: #f8fafc;
    }

    .stepper-container {
        max-width: 800px;
        margin: 0 auto 3rem auto;
    }

    .stepper {
        display: flex;
        justify-content: space-between;
        position: relative;
    }

        .stepper::before {
            content: "";
            position: absolute;
            top: 20px;
            left: 10%;
            right: 10%;
            height: 3px;
            background: #e2e8f0;
            z-index: 1;
        }

    .step {
        text-align: center;
        position: relative;
        z-index: 2;
        flex: 1;
    }

    .circle {
        width: 44px;
        height: 44px;
        background: #fff;
        border: 3px solid #e2e8f0;
        color: #64748b;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.1rem;
        transition: 0.3s;
    }

    .step.active .circle, .step.completed .circle {
        background: #3b82f6;
        border-color: #3b82f6;
        color: white;
    }

    .step p {
        margin-top: 0.8rem;
        font-weight: 600;
        color: #64748b;
    }

    .step.active p {
        color: #0f172a;
    }

    .select-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        cursor: pointer;
        transition: 0.3s;
        border: 2px solid transparent;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        height: 100%;
    }

        .select-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

    input[type=radio]:checked + .select-card {
        border-color: #3b82f6;
        background: #eff6ff;
    }

    .barber-img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 1rem;
        border: 3px solid #f1f5f9;
    }

    .step-content {
        display: none;
        animation: fadeIn 0.4s;
        max-width: 900px;
        margin: 0 auto;
    }

        .step-content.active {
            display: block;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark">Book Your Session at <span class="text-primary">@ViewBag.ShopName</span></h2>
        <p class="text-muted">Select your service, choose an expert, and secure your slot.</p>
    </div>

    <div class="stepper-container">
        <div class="stepper">
            <div class="step active" id="indicator1"><div class="circle">1</div><p>Service</p></div>
            <div class="step" id="indicator2"><div class="circle">2</div><p>Barber</p></div>
            <div class="step" id="indicator3"><div class="circle">3</div><p>Schedule</p></div>
        </div>
    </div>

    <form asp-action="Book" asp-route-shopSlug="@ViewBag.ShopSlug" method="post" id="bookingForm">

        <div class="step-content active" id="step1">
            <div class="row g-4 mb-4">
                @if (ViewBag.Services != null)
                {
                    foreach (var service in ViewBag.Services)
                    {
                        <div class="col-md-4">
                            <label class="w-100 h-100">
                                <input type="radio" name="ServiceId" value="@service.ServiceId" hidden />
                                <div class="select-card d-flex flex-column justify-content-center">
                                    <h5 class="fw-bold text-dark mb-2">@service.Name</h5>
                                    <h4 class="text-primary fw-bold mb-0">₹@service.Price</h4>
                                    <small class="text-muted mt-2"><i class="bi bi-clock"></i> @service.Duration mins</small>
                                </div>
                            </label>
                        </div>
                    }
                }
            </div>
            <div class="text-end">
                <button type="button" class="btn btn-primary rounded-pill px-5 py-2 fw-bold" onclick="validateStep(1)">Next Step <i class="bi bi-arrow-right ms-2"></i></button>
            </div>
        </div>

        <div class="step-content" id="step2">
            <div class="row g-4 mb-4">
                @if (ViewBag.Barbers != null)
                {
                    foreach (var barber in ViewBag.Barbers)
                    {
                        <div class="col-md-4">
                            <label class="w-100 h-100">
                                <input type="radio" name="BarberId" value="@barber.BarberId" hidden />
                                <div class="select-card">
                                    @{
                                        var barberImg = string.IsNullOrEmpty(barber.PhotoUrl)
                                        ? $"https://ui-avatars.com/api/?name={barber.Name}&background=0f172a&color=fff&size=150&bold=true"
                                        : barber.PhotoUrl;
                                    }
                                    <img src="@barberImg" class="barber-img" onerror="this.src='https://ui-avatars.com/api/?name=@barber.Name&background=0f172a&color=fff&size=150&bold=true'" />
                                    <h6 class="fw-bold mb-1">@barber.Name</h6>
                                    <span class="badge bg-light text-dark border">@barber.Specialization</span>
                                </div>
                            </label>
                        </div>
                    }
                }
            </div>
            <div class="d-flex justify-content-between">
                <button type="button" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-bold" onclick="showStep(1)"><i class="bi bi-arrow-left me-2"></i> Back</button>
                <button type="button" class="btn btn-primary rounded-pill px-5 py-2 fw-bold" onclick="validateStep(2)">Next Step <i class="bi bi-arrow-right ms-2"></i></button>
            </div>
        </div>

        <div class="step-content" id="step3">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-body p-4 p-md-5">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="fw-bold mb-2">Select Date</label>
                            <input type="date" class="form-control form-control-lg bg-light border-0" asp-for="BookingDate" id="dateInput" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="fw-bold mb-2">Select Time</label>
                            <div class="d-flex gap-2 flex-wrap" id="timeSlotContainer">
                                @{
                                    var slots = new List<string> { "10:00 AM", "11:30 AM", "01:00 PM", "02:30 PM", "04:00 PM", "05:30 PM", "07:00 PM" };
                                    foreach (var slot in slots)
                                    {
                                        var slotId = "slot_" + slot.Replace(" ", "").Replace(":", "");
                                        <input type="radio" asp-for="TimeSlot" value="@slot" id="@slotId" class="btn-check time-slot-radio" required />
                                        <label for="@slotId" class="btn btn-outline-primary fw-semibold px-3 py-2 rounded-pill time-slot-label">@slot</label>
                                    }
                                }
                            </div>
                            <small id="slotWarning" class="text-danger d-none mt-2"><i class="bi bi-info-circle"></i> Please select a date first.</small>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4 rounded-3 border-0 bg-primary bg-opacity-10 d-flex align-items-center">
                        <i class="bi bi-shield-check fs-4 text-primary me-3"></i>
                        <div>
                            <strong>Advance Payment Required:</strong> A 20% secure deposit will be collected on the next screen to confirm your slot at @ViewBag.ShopName.
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <button type="button" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-bold" onclick="showStep(2)"><i class="bi bi-arrow-left me-2"></i> Back</button>
                        <button type="submit" class="btn btn-success rounded-pill px-5 py-2 fw-bold" id="confirmBtn"><i class="bi bi-lock me-2"></i> Secure Slot & Pay</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    document.getElementById("dateInput").addEventListener("change", function() {
        let selectedDate = this.value;
        let selectedBarber = document.querySelector('input[name="BarberId"]:checked');
        let slotWarning = document.getElementById("slotWarning");

        if (!selectedBarber) {
            alert('Please select a barber first!');
            this.value = '';
            showStep(2);
            return;
        }

        let barberId = selectedBarber.value;
        slotWarning.classList.remove('d-none', 'text-danger');
        slotWarning.classList.add('text-primary');
        slotWarning.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Checking real-time availability...';

        document.querySelectorAll('.time-slot-radio').forEach(radio => {
            radio.disabled = true;
            let label = document.querySelector(`label[for="${radio.id}"]`);
            label.classList.add('opacity-50');
        });

        fetch(`/Booking/GetBookedSlots?barberId=${barberId}&date=${selectedDate}`)
            .then(response => response.json())
            .then(bookedSlots => {
                let totalSlots = 0;
                let takenSlots = 0;

                document.querySelectorAll('.time-slot-radio').forEach(radio => {
                    totalSlots++;
                    radio.disabled = false;
                    radio.checked = false;
                    let label = document.querySelector(`label[for="${radio.id}"]`);
                    label.classList.remove('btn-outline-secondary', 'text-decoration-line-through', 'opacity-50');
                    label.classList.add('btn-outline-primary');

                    if (bookedSlots.includes(radio.value)) {
                        radio.disabled = true;
                        takenSlots++;
                        label.classList.remove('btn-outline-primary');
                        label.classList.add('btn-outline-secondary', 'text-decoration-line-through', 'opacity-50');
                    }
                });

                if (takenSlots === totalSlots) {
                    slotWarning.classList.replace('text-primary', 'text-danger');
                    slotWarning.innerHTML = '<i class="bi bi-x-circle me-1"></i> Fully booked for this date. Please select another day.';
                } else {
                    slotWarning.classList.add('d-none');
                }
            })
            .catch(error => {
                console.error('Error fetching slots:', error);
                slotWarning.classList.replace('text-primary', 'text-danger');
                slotWarning.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i> Error loading schedule.';
            });
    });

    function validateStep(currentStep) {
        if (currentStep === 1) {
            if (!document.querySelector('input[name="ServiceId"]:checked')) {
                alert('Please select a grooming service');
                return;
            }
            showStep(2);
        } else if (currentStep === 2) {
            if (!document.querySelector('input[name="BarberId"]:checked')) {
                alert('Please choose your preferred barber');
                return;
            }
            let dateInput = document.getElementById("dateInput");
            if(dateInput.value !== "") {
                let event = new Event('change');
                dateInput.dispatchEvent(event);
            }
            showStep(3);
        }
    }

    function showStep(step) {
        document.querySelectorAll(".step-content").forEach(s => s.classList.remove("active"));
        document.getElementById("step" + step).classList.add("active");

        for (let i = 1; i <= 3; i++) {
            let indicator = document.getElementById("indicator" + i);
            if (i < step) {
                indicator.className = "step completed";
            } else if (i === step) {
                indicator.className = "step active";
            } else {
                indicator.className = "step";
            }
        }
    }
</script>