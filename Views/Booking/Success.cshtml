@{
    ViewData["Title"] = "Booking Initiated";
}

<div class="container mt-5 mb-5 d-flex justify-content-center" style="font-family: 'Plus Jakarta Sans', sans-serif;">
    <div class="card border-0 shadow-sm text-center" style="max-width: 500px; border-radius: 20px; padding: 3rem 2rem;">
        <div class="mb-4">
            <i class="bi bi-calendar-check text-success" style="font-size: 5rem;"></i>
        </div>
        <h2 class="fw-bold text-dark mb-3">Request Received!</h2>
        <p class="text-muted mb-4">
            Your barber appointment slot has been reserved. Please ensure your advance payment is completed to fully confirm your session.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/Booking/MyBookings" class="btn btn-dark rounded-pill px-4 py-2 fw-bold">View My Bookings</a>
            <a href="/Store" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-bold">Browse Store</a>
        </div>
    </div>
</div>