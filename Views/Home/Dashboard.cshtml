@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            height: 100vh;
            background: linear-gradient(135deg, #b06ab3, #4568dc);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .menu-box {
            background: white;
            padding: 30px;
            border-radius: 15px;
            width: 320px;
            text-align: center;
        }

            .menu-box h5 {
                margin-bottom: 20px;
            }

        .menu-btn {
            margin-top: 15px;
        }
    </style>
</head>

<body>
    <div class="menu-box">
        <h5>Main Menu</h5>

        <a href="/Booking/Book" class="btn btn-dark w-100 menu-btn">
            Book Appointment
        </a>

        <a href="/Store/Index" class="btn btn-dark w-100 menu-btn">
            Online Store
        </a>

        <a href="/Rating/Index" class="btn btn-dark w-100 menu-btn">
            Rate Barber
        </a>
    </div>
</body>
</html>
