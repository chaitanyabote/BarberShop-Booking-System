@using BarberShopMVC_2.Helpers
@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BarberShop </title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body style="background:#f5f7fa;">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-scissors"></i> BarberShop Booking Hub
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="ShopDirectory" asp-action="Index" class="nav-link fw-bold text-info">
                                <i class="bi bi-search me-1"></i> Find a Shop
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Store" asp-action="Index" class="nav-link">Store</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Doctor" asp-action="Index" style="color: #60a5fa !important;">
                                <i class="bi bi-heart-pulse"></i> Consult Doctor
                            </a>
                        </li>

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            @if (Context.Session.GetInt32("IsAdmin") == 1)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-bold" asp-controller="ShopAdmin" asp-action="Index">Admin Portal</a>
                                </li>
                            }

                            @if (Context.Session.GetInt32("BarberId") != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-success fw-bold" asp-controller="BarberDashboard" asp-action="Index">Barber Dashboard</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item me-3">
                            <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart"></i>
                                <span class="badge rounded-pill bg-danger">@CartHelper.GetCartCount(Context)</span>
                            </a>
                        </li>

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" data-bs-toggle="dropdown">
                                    Welcome, @Context.Session.GetString("UserName")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="MyOrders">Store Orders</a></li>
                                    <li><a class="dropdown-item" asp-controller="DBooking" asp-action="MyConsultations">Medical Bookings</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">Logout</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light rounded-pill px-4" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-5 bg-dark text-light pt-4 pb-3">
        <div class="container text-center text-secondary small">
            © 2026 BarberShopMVC_2 | Computer Engineering Project
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const Toast = Swal.mixin({
            toast: true, position: 'top-end', showConfirmButton: false, timer: 3000
        });
    </script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>Toast.fire({ icon: 'success', title: '@TempData["SuccessMessage"]' });</script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>Toast.fire({ icon: 'error', title: '@TempData["ErrorMessage"]' });</script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>