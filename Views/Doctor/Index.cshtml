@model List<BarberShopMVC_2.Models.Dermatologist>

@{
    ViewData["Title"] = "Skin & Hair Care Experts";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    /* Scope styles to this page to avoid layout conflicts */
    .saas-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #f8fafc;
        min-height: 100vh;
        padding-bottom: 3rem;
    }

    /* Premium Hero Section */
    .hero-section {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: white;
        padding: 4rem 1rem;
        border-radius: 0 0 2rem 2rem;
        margin-bottom: 3rem;
        text-align: center;
        box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.5);
    }

        .hero-section h2 {
            font-weight: 700;
            font-size: 2.5rem;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
        }

        .hero-section p {
            color: #94a3b8;
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto;
        }

    /* Modern Card Design */
    .saas-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #f1f5f9;
        padding: 1.5rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .saas-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            border-color: #e2e8f0;
        }

    /* Doctor Profile Layout */
    .doc-profile-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .doc-img-wrapper {
        position: relative;
    }

    .doctor-img {
        width: 85px;
        height: 85px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #f8fafc;
        box-shadow: 0 4px 14px rgba(0,0,0,0.1);
    }

    .rating-badge {
        position: absolute;
        bottom: -5px;
        right: -5px;
        background: #f59e0b;
        color: white;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 10px;
        border: 2px solid white;
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .doctor-info h4 {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 700;
        color: #0f172a;
    }

    .spec-text {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 500;
        margin-top: 0.2rem;
    }

    /* Detail Badges */
    .doc-details {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .saas-badge {
        background: #f1f5f9;
        color: #475569;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        .saas-badge i {
            color: #3b82f6;
        }

    /* Premium Button */
    .btn-saas-book {
        margin-top: auto;
        width: 100%;
        background: #0f172a;
        color: white;
        border: none;
        padding: 0.8rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s;
        text-align: center;
        text-decoration: none;
    }

        .btn-saas-book:hover {
            background: #3b82f6;
            color: white;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }

    /* Entrance Animation */
    .fade-up {
        animation: fadeUpAnim 0.6s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }

    @@keyframes fadeUpAnim {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="saas-page">
    <div class="hero-section">
        <div class="container">
            <h2>Consult Top Specialists</h2>
            <p>Get personalized, science-backed skin and hair care routines from verified medical experts.</p>

            <div class="mt-4">
                <a asp-controller="Doctor" asp-action="SkinCareInfo" class="btn btn-outline-light rounded-pill px-4 py-2" style="border-width: 2px; font-weight: 500; transition: 0.3s;">
                    <i class="bi bi-book me-2"></i> Read the Skin & Hair Care Guide
                </a>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                var delay = 0.1;
                foreach (var doctor in Model)
                {
                    <div class="col-lg-4 col-md-6 fade-up" style="animation-delay: @(delay)s">
                        <div class="saas-card">

                            <div class="doc-profile-header">
                                <div class="doc-img-wrapper">
                                    @{
                                        var docImgUrl = string.IsNullOrEmpty(doctor.ImageUrl)
                                        ? $"https://ui-avatars.com/api/?name={doctor.Name}&background=0f172a&color=fff&size=150&bold=true"
                                        : doctor.ImageUrl;
                                    }
                                    <img src="@docImgUrl"
                                         class="doctor-img"
                                         alt="@doctor.Name"
                                         onerror="this.src='https://ui-avatars.com/api/?name=@doctor.Name&background=0f172a&color=fff&size=150&bold=true'" />

                                    <div class="rating-badge">
                                        <i class="bi bi-star-fill"></i> 4.9
                                    </div>
                                </div>
                                <div class="doctor-info">
                                    <h4>@doctor.Name</h4>
                                    <div class="spec-text">@doctor.Specialization</div>
                                </div>
                            </div>

                            <div class="doc-details">
                                <div class="saas-badge">
                                    <i class="bi bi-briefcase-fill"></i> @doctor.Experience Yrs Exp.
                                </div>
                                <div class="saas-badge">
                                    <i class="bi bi-camera-video-fill"></i> Video Consult
                                </div>
                            </div>

                            <a asp-controller="DBooking" asp-action="Book" asp-route-doctorId="@doctor.DermatologistId" class="btn-saas-book">
                                Book Consultation
                            </a>
                        </div>
                    </div>
                    delay += 0.1;
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <h4 class="text-muted" style="font-family: 'Plus Jakarta Sans', sans-serif;">No specialists available at the moment.</h4>
                </div>
            }
        </div>
    </div>
</div>