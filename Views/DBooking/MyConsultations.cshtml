@model IEnumerable<BarberShopMVC_2.Models.DBooking>

@{
    ViewData["Title"] = "My Medical Consultations";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">My Consultations</h2>
        <a href="/@ViewBag.ShopSlug/ShopDirectory/Index" class="btn btn-outline-secondary rounded-pill px-4">Back to Shop</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4 text-uppercase text-muted" style="font-size: 0.85rem;">Date & Time</th>
                        <th class="py-3 text-uppercase text-muted" style="font-size: 0.85rem;">Clinic</th>
                        <th class="py-3 text-uppercase text-muted" style="font-size: 0.85rem;">Doctor</th>
                        <th class="py-3 text-uppercase text-muted" style="font-size: 0.85rem;">Status</th>
                        <th class="py-3 text-uppercase text-muted" style="font-size: 0.85rem;">Paid (Advance)</th>
                        <th class="py-3 px-4 text-uppercase text-muted" style="font-size: 0.85rem;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var booking in Model)
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="fw-bold text-dark">@booking.BookingDate.ToString("MMM dd, yyyy")</div>
                                    <div class="text-muted small">@booking.TimeSlot</div>
                                </td>
                                <td class="py-3 fw-semibold text-primary">
                                    @(booking.Shop?.ShopName ?? "Central Clinic")
                                </td>
                                <td class="py-3">
                                    <div class="fw-bold">@booking.Dermatologist?.Name</div>
                                    <div class="text-muted small">@booking.Dermatologist?.Specialization</div>
                                </td>
                                <td class="py-3">
                                    @if (booking.Status == "Completed")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-2">Completed</span>
                                    }
                                    else if (booking.Status == "Pending Payment")
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill px-3 py-2">Awaiting Payment</span>
                                    }
                                    else if (booking.Status == "Confirmed")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill px-3 py-2">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill px-3 py-2">@booking.Status</span>
                                    }
                                </td>
                                <td class="py-3 fw-bold text-dark">
                                    ₹@booking.AdvancePaid
                                </td>
                                <td class="px-4 py-3">
                                    @if (booking.Status == "Pending Payment")
                                    {
                                        <a asp-controller="Payment" asp-action="Checkout"
                                           asp-route-id="@booking.DBookingId"
                                           asp-route-module="Medical"
                                           asp-route-shopSlug="@ViewBag.ShopSlug"
                                           class="btn btn-sm btn-success rounded-pill px-3 fw-bold">Pay Now</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-check-circle-fill text-success"></i> Secured</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <h5 class="text-muted">You have no upcoming consultations.</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>