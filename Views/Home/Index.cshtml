@{
    var slug = ViewContext.RouteData.Values["shopSlug"]?.ToString();
}
<div class="header-block" style="background: #0f172a; height: 200px;"></div>
<div class="container" style="margin-top: -100px;">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow border-0 rounded-4 p-4 h-100 text-center">
                <i class="bi bi-scissors display-4 mb-3"></i>
                <h5>Barber Services</h5>
                @if (!string.IsNullOrEmpty(slug))
                {
                    <a href="/@slug/Booking/Book" class="btn btn-primary w-100 mt-auto">BOOK NOW</a>
                }
                else
                {
                    <a asp-controller="ShopDirectory" asp-action="Index" class="btn btn-dark w-100 mt-auto">FIND SHOP</a>
                }
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow border-0 rounded-4 p-4 h-100 text-center">
                <i class="bi bi-bag display-4 mb-3"></i>
                <h5>Store</h5>
                <a asp-controller="Store" asp-action="Index" class="btn btn-dark w-100 mt-auto">SHOP NOW</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow border-0 rounded-4 p-4 h-100 text-center">
                <i class="bi bi-heart-pulse display-4 mb-3"></i>
                <h5>Medical</h5>
                <a asp-controller="Doctor" asp-action="Index" class="btn btn-dark w-100 mt-auto">CONSULT DOCTOR</a>
            </div>
        </div>
    </div>
</div>